    <properties>
        <!-- 项目自身版本 (CI-friendly versions 根, 发版改这一处即可) -->
        <revision>0.2.1</revision>

        <!-- 删掉的键(父链同面值下发, 本仓不再重复声明): maven.compiler.source/target=8、
             project.build.sourceEncoding=UTF-8、flatten-maven-plugin.version=1.7.3
             (z-boot-parent/pom.xml:56-58,70)、okhttp.version=4.12.0、jackson.version=2.18.6. -->

        <!-- Maven 插件版本: 父链的 pluginManagement 只兜 compiler/surefire/failsafe/jar/resources/
             spring-boot, 下面这些父链不供(或面值不同), 全部留在本仓. -->
        <maven-deploy-plugin.version>3.1.4</maven-deploy-plugin.version>
        <!-- 分歧保留: 父链 z-boot-dependencies/pom.xml:33 是 3.2.1, 本仓基线一直用 3.3.0
             ⇒ 删掉这个键就是把 sources jar 的生成器换版, 不在这次迁移里顺手做. -->
        <maven-source-plugin.version>3.3.0</maven-source-plugin.version>
        <maven-javadoc-plugin.version>3.11.2</maven-javadoc-plugin.version>
        <maven-gpg-plugin.version>3.2.7</maven-gpg-plugin.version>
        <central-publishing-plugin.version>0.8.0</central-publishing-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 自钉本仓 26 个 reactor 坐标 = ${project.version}. 这一格不是装饰:
                 z-boot-fleet 里 z-agent-kernel-* 槽位钉的是 repo1 上的 **0.1.1**(0.2.0/0.2.1 实测 404),
                 而继承来的 DM 会改写**传递依赖**的版本 ⇒ 不写这 26 条, 模块之间拿到的兄弟件就是 0.1.1.
                 子模块的 <dependency> 因此一律不写版本(以前写 ${revision} 的 9 处已删). -->
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-agent-kernel</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-agent-kernel-types</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-agent-kernel-exception</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-agent-kernel-classifier</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-agent-kernel-message</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-agent-kernel-tool</artifactId>
                <version>${project.version}</version>
