<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        z-agent-kernel: agent 框架基座, 25 个子模块 1:1 对齐 agentScope Python 内部结构.
        - 11 个核心 SDK 包 (装 SPI + 默认实现): llm / message / tool / memory / agent / event / middleware / state / pipeline / workspace / formatter
        - 8 个扩展 SPI 包 (只装接口, 0 实现): embedding / rag / tts / realtime / skill / mcp / credential / permission
        - 3 个框架包 (类型/异常/分类器): types / exception / classifier
        - 2 个 UI SPI 包 (前端接口): console / tui
        - 1 个应用框架: app
        上层仓 z-llm / z-mcp / z-skill / z-bot / z-agent-proxy / z-agent 各取所需子模块 declare.
        发版模式: reversion (CI-friendly versions) + flatten-maven-plugin, 跟 z-boot 同源.

        消费入口: z-boot-parent:1.0.19 —— 父链 = z-boot-parent -> z-boot-dependencies:1.0.19(第三方地板,
        156 条) + import z-boot-fleet:1.0.0(兄弟仓版本格), 另下发 Java 8 的 pluginManagement
        (maven-compiler-plugin 3.11.0 + -parameters / maven-surefire-plugin 2.22.2; 本仓原本没有这两条
        声明, 所以这里无需删除, 迁移后它们由父链供给).
        relativePath 必须留空: 这个 parent 不在磁盘上, 在 repo1.
    -->
    <parent>
        <groupId>io.github.yuku123</groupId>
        <artifactId>z-boot-parent</artifactId>
        <version>1.0.21</version>
        <relativePath/>
    </parent>

    <groupId>io.github.yuku123</groupId>
    <artifactId>z-agent-kernel</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

